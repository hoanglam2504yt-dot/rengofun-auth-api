# ==========================================
# rengofun-auth-api — .env.example
# Sao chép file này thành .env và điền giá trị thật.
# KHÔNG commit file .env lên Git!
# ==========================================

# ── MongoDB Atlas ──────────────────────────────────────────────────────────────
# Lấy connection string từ: https://cloud.mongodb.com → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# ── JWT Security ───────────────────────────────────────────────────────────────
# Chuỗi ngẫu nhiên tối thiểu 64 ký tự. Sinh bằng: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_super_secret_jwt_key_minimum_64_characters_long_replace_this

# ── SMTP (Gmail App Password) ──────────────────────────────────────────────────
# Hướng dẫn lấy App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password
SMTP_FROM=RenGoFun <your_gmail_address@gmail.com>
