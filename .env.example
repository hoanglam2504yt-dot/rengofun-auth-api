# ==========================================
# rengofun-auth-api — .env.example
# Sao chép file này thành .env và điền giá trị thật.
# KHÔNG commit file .env lên Git!
# ==========================================

# ── Server & CORS ──────────────────────────────────────────────────────────────
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost

# ── MongoDB Atlas ──────────────────────────────────────────────────────────────
# Lấy connection string từ: https://cloud.mongodb.com -> Connect -> Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# ── JWT Security & Token Lifetime & Bootstrap Admin ────────────────────────────
# Chuỗi ngẫu nhiên tối thiểu 64 ký tự. Sinh bằng: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_super_secret_jwt_key_minimum_64_characters_long_replace_this
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# ── Device Limits & Offline Grace Period ───────────────────────────────────────
MAX_DEVICES_FREE=1
MAX_DEVICES_PRO=2
OFFLINE_GRACE_DAYS=7

# ── OTP Email via Resend HTTP API (Khuyên dùng cho Render thay vì cổng SMTP 587) ─
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=RenGoFun <onboarding@resend.dev>

# ── SMTP Fallback (Chỉ dùng khi chạy Local trên máy tính) ──────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password
SMTP_FROM=RenGoFun <your_gmail_address@gmail.com>

# ── Payment Webhook Secret & VietQR Config ─────────────────────────────────────
PAYMENT_WEBHOOK_SECRET=your_webhook_hmac_secret_key
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=000000000000
VIETQR_ACCOUNT_NAME=RENGOFUN STUDIO

# ── RS256 Offline License Keypair (Single-line PEM with \n escapes) ───────────
JWT_RS256_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_RS256_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
