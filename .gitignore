# ==============================================================================
# rengofun-auth-api (Cloud Auth API) - Git Ignore Configuration
# ==============================================================================

# --- 1. Environment & Sensitive Credentials (TUYỆT ĐỐI KHÔNG ĐẨY LÊN GITHUB) ---
# Chứa MONGO_URI, SECRET_KEY, SMTP_USER, SMTP_PASSWORD, RESEND_API_KEY...
.env
*.env
.env.local
.env.*.local
.env.*
!.env.example
!.env.local.example
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx

# --- 2. Python Virtual Environments ---
venv/
.venv/
env/
ENV/

# --- 3. Python Bytecode, Lint & Test Cache ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage/
htmlcov/

# --- 4. Build & Distribution ---
build/
dist/
*.egg-info/
node_modules/

# --- 5. Logs & Local Databases ---
logs/
*.log
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.db
*.db-shm
*.db-wal
*.db-journal

# --- 6. Dev/Test/Migration Scripts, Launchers & Scratch Files (Chỉ chạy nội bộ) ---
migrate_db.py
test_*.py
seed_*.py
scratch_*
*.bat
*.vbs
*.lnk
*.tmp
*.bak
md/
docs/
.agents/
.antigravity/

# --- 7. Editor, IDE & OS Artifacts ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
