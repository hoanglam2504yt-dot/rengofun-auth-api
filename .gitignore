# ==============================================================================
# rengofun-auth-api (Cloud Auth API) - Git Ignore Configuration
# ==============================================================================

# --- 1. Environment & Sensitive Credentials (TUYỆT ĐỐI KHÔNG ĐẨY LÊN GITHUB) ---
# Chứa MONGODB_URL, JWT_SECRET_KEY, RESEND_API_KEY, BREVO_API_KEY...
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# --- 2. Python Virtual Environments ---
venv/
.venv/
env/
ENV/

# --- 3. Python Bytecode & Test Cache ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# --- 4. Build & Distribution ---
build/
dist/
*.egg-info/
node_modules/

# --- 5. Logs & Local Databases ---
logs/
*.log
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.db
*.db-shm
*.db-wal
*.db-journal

# --- 6. Dev/Test/Migration Scripts & Scratch Files (Chỉ chạy nội bộ) ---
migrate_db.py
test_*.py
seed_*.py
scratch_*
start_*.bat
start_*.vbs
*.tmp
*.bak
md/
docs/
.agents/

# --- 7. Editor, IDE & OS Artifacts ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
